# Copy to /etc/leafwiki-agent/enroll.env and chmod 600.
# Use a dedicated LeafWiki admin account for provisioning, not the personal
# administrator account, and do not enable TOTP on that account.
LEAFWIKI_BASE_URL=https://wiki.kkuu.de
LEAFWIKI_ADMIN_USERNAME=agent-provisioner
LEAFWIKI_ADMIN_PASSWORD=replace-with-a-long-random-password

# Keep the enrollment service on loopback. Remote agents should use an SSH
# tunnel, or Nginx should proxy a dedicated /agent-enroll/register path.
AGENT_ENROLL_BIND=127.0.0.1
AGENT_ENROLL_PORT=8788
AGENT_ENROLL_CODES_FILE=/var/lib/leafwiki-enroll/enrollment-codes.json
AGENT_ENROLL_REGISTRY_DIR=/var/lib/leafwiki-enroll/agent-keys
AGENT_ENROLL_ALLOWED_IPS=127.0.0.1
AGENT_ENROLL_TRUST_PROXY=false
AGENT_ENROLL_IP_LIMIT=10
AGENT_ENROLL_GLOBAL_LIMIT=100

# If Nginx on the same host proxies the endpoint, use:
# AGENT_ENROLL_TRUST_PROXY=true
# AGENT_ENROLL_ALLOWED_IPS=

# editor 自助发码令牌（为空则关闭 editor 自助，仅 viewer 自助）
AGENT_ENROLL_EDITOR_TOKEN=
