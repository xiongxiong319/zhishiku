# Put the limit_req_zone line once in the http { ... } context.
limit_req_zone $binary_remote_addr zone=leafwiki_enroll:10m rate=10r/m;

# Put this location inside the existing server { ... } block for
# https://wiki.kkuu.de. Do not create a second server block for the same name.
location = /agent-enroll/register {
    limit_req zone=leafwiki_enroll burst=5 nodelay;

    proxy_pass http://127.0.0.1:8788/register;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Optional: expose a minimal health check only to trusted networks.
# location = /agent-enroll/health {
#     allow 10.0.0.0/8;
#     deny all;
#     proxy_pass http://127.0.0.1:8788/health;
# }
